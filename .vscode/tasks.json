{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "General Agent: Database",
      "type": "shell",
      "command": "docker compose up -d --build --wait",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "general-agent"
      }
    },
    {
      "label": "General Agent: Backend",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "general_agent.app:create_app",
        "--factory",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "general-agent-backend",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "general-agent"
      }
    },
    {
      "label": "General Agent: Frontend",
      "type": "shell",
      "command": "pnpm.cmd --dir frontend dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "general-agent-frontend",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*http://127\\.0\\.0\\.1:5173/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "general-agent"
      }
    }
  ]
}
