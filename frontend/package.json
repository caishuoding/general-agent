{
  "name": "general-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test && playwright test --config playwright.capabilities.config.ts && playwright test --config playwright.images.config.ts && playwright test --config playwright.search.config.ts && playwright test --config playwright.history.config.ts && playwright test --config playwright.source-deletion.config.ts && playwright test --config playwright.rebuild.config.ts",
    "test:capabilities": "playwright test --config playwright.capabilities.config.ts",
    "test:images": "playwright test --config playwright.images.config.ts",
    "test:search": "playwright test --config playwright.search.config.ts",
    "test:history": "playwright test --config playwright.history.config.ts",
    "test:source-deletion": "playwright test --config playwright.source-deletion.config.ts",
    "test:rebuild": "playwright test --config playwright.rebuild.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
