{
  "name": "general-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test && playwright test --config playwright.capabilities.config.ts && playwright test --config playwright.budget.config.ts && playwright test --config playwright.memory.config.ts && playwright test --config playwright.recall.config.ts && playwright test --config playwright.correction.config.ts && playwright test --config playwright.images.config.ts",
    "test:budget": "playwright test --config playwright.budget.config.ts",
    "test:capabilities": "playwright test --config playwright.capabilities.config.ts",
    "test:memory": "playwright test --config playwright.memory.config.ts",
    "test:recall": "playwright test --config playwright.recall.config.ts",
    "test:correction": "playwright test --config playwright.correction.config.ts",
    "test:images": "playwright test --config playwright.images.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@playwright/test": "^1.56.0"
  }
}
